    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./firestore": "./src/firestore.ts"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1"
  }
}
