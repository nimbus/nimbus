{
  "name": "firebase",
  "version": "0.1.46",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "codegen:proto": "node ./src/codegen-protos.mjs",
    "build": "npm run codegen:proto && node ../../scripts/build-js-package.mjs firebase",
    "test": "npm run codegen:proto && node ./src/selftest.mjs",
    "typecheck": "npm run codegen:proto && node ./src/selftest.mjs --typecheck-only"
