    "lane_targets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "api_families": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "package_classes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "doc_generation": {
      "type": "object"
    },
    "doc_claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
