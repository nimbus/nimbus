{
  "type": "object",
  "required": [
    "schema_version",
    "profile_kind",
    "as_of",
    "owning_plan",
    "description",
    "engine",
    "support_statuses",
    "verification_states",
    "failure_classes",
    "wide_then_focused_strategy",
    "lane_targets",
    "evidence_refs",
    "api_families",
