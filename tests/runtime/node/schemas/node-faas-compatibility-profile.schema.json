          "id",
          "label",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification_states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "wide_then_focused_strategy": {
      "type": "object",
      "required": [
        "required",
        "wide_run_inventory_required",
        "focused_fix_required_for_supported_bugs",
        "final_wide_rerun_required",
        "proof_fields"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "wide_run_inventory_required": {
          "type": "boolean"
        },
        "focused_fix_required_for_supported_bugs": {
          "type": "boolean"
        },
        "final_wide_rerun_required": {
          "type": "boolean"
        },
        "proof_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
