        "id",
        "implementation_claim",
        "new_engine_proof_harness"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "v8_deno_core"
        },
        "implementation_claim": {
          "type": "string",
          "minLength": 1
