{
  "name": "nimbus-workspace",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "packages/convex",
    "packages/firebase",
    "packages/nimbus",
    "packages/nimbus-ui",
    "packages/codegen",
    "packages/mongodb",
    "packages/dynamodb",
    "demos/convex/html",
    "demos/convex/http",
    "demos/convex/node",
    "demos/firebase/html",
    "demos/mongodb/node",
    "demos/nimbus/html"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:embedded-packages": "npm run build -w convex -w @nimbus/nimbus -w firebase -w @nimbus/mongodb -w @nimbus/dynamodb -w @nimbus/codegen && node scripts/stage-embedded-packages.mjs",
    "lint:capability-boundary": "biome lint --config-path ./biome.json packages/convex/src packages/firebase/src packages/mongodb/src packages/dynamodb/src",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs:validate-refs:strict": "node scripts/validate-docs-refs.mjs",
    "convex:codegen": "cargo run -p nimbus-bin -- codegen --app demos/convex/html",
    "convex:codegen:node": "cargo run -p nimbus-bin -- codegen --app demos/convex/node",
    "convex:build": "npm run build",
    "convex:test": "npm run test",
    "convex:typecheck": "npm run typecheck",
    "convex:server:node": "cargo run -p nimbus-bin -- start --port 8080 --app-dir ./demos/convex/node",
    "convex:server:html": "cargo run -p nimbus-bin -- start --port 8080 --app-dir ./demos/convex/html",
    "convex:server:http": "cargo run -p nimbus-bin -- start --port 8080 --app-dir ./demos/convex/http",
    "convex:demo:node": "npm run demo --workspace convex-node",
    "convex:demo:html": "npm run dev --workspace convex-html",
    "convex:demo:http": "npm run dev --workspace convex-http",
    "firebase:server:html": "cargo run -p nimbus-bin -- start --port 8080",
    "firebase:demo:html": "npm run dev --workspace firebase-html",
    "nimbus:demo:html": "npm run dev --workspace nimbus-html"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.13"
  }
}
