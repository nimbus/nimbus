{
  "schemaVersion": 1,
  "sourceGuardPaths": [
    "package.json",
    "package-lock.json",
    "compose.yaml"
  ],
  "ignoredAppPaths": [
    ".env.local",
    ".nimbus",
    "node_modules",
    "dist",
    "functions/lib"
  ],
  "cases": [
    {
      "name": "nimbus/tasks",
      "workspace": "nimbus-tasks",
      "appDir": "examples/nimbus/tasks",
      "prepare": {
        "codegen": false,
        "inputs": [
          "README.md",
          "index.html",
          "package.json",
          "smoke.ts",
          "src/app.css",
          "src/main.ts",
          "src/vite-env.d.ts",
          "tsconfig.json",
          "tsconfig.smoke.json",
          "vite.config.ts"
        ]
      },
      "boot": {
        "mode": "start",
        "needsAppDir": false,
        "environment": [],
        "flags": []
      },
      "smoke": {
        "command": "npm",
        "environment": ["NIMBUS_NATIVE_URL=${NIMBUS_URL}"],
        "stdioContract": false
      },
      "surfaces": ["native-http", "websocket"],
      "updateSemantics": "push",
      "expectedAnchors": [
        "tasks.create",
        "tasks.list",
        "tasks.toggle",
        "tasks.delete",
        "tasks.live-update"
      ]
    },
    {
      "name": "nimbus/agent-chat",
