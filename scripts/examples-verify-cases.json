          "src/vite-env.d.ts",
          "tsconfig.json",
          "tsconfig.smoke.json",
          "vite.config.ts"
        ]
      },
      "boot": {
        "mode": "start",
        "needsAppDir": true,
        "environment": [
          "NIMBUS_CONVEX_SILO_TEAMS=demo:demo-team",
          "NIMBUS_CONVEX_ANONYMOUS_TEAM=demo-team"
        ],
        "flags": []
