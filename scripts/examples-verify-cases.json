      "smoke": {
        "command": "node",
        "environment": ["NIMBUS_NATIVE_URL=${NIMBUS_URL}"],
        "stdioContract": false
      },
      "surfaces": ["convex-http", "scheduler", "websocket"],
      "updateSemantics": "push",
      "expectedAnchors": [
        "agent-chat.converse",
        "agent-chat.remember",
        "agent-chat.recall",
        "agent-chat.schedule"
      ]
    },
