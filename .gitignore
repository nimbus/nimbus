# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# JavaScript / TypeScript workspace
node_modules
**/node_modules
# Official Node fixtures include nested node_modules trees that are test data,
# not install output; keep them versioned so CI runs the same corpus as local.
!crates/nimbus-runtime/src/runtime/tests/node_compat_fixtures/**/node_modules/
!crates/nimbus-runtime/src/runtime/tests/node_compat_fixtures/**/node_modules/**
dist
**/dist
# Official Node fixtures include transpiled dist/ trees that are test data,
# not build output; keep them versioned so CI runs the same corpus as local.
!crates/nimbus-runtime/src/runtime/tests/node_compat_fixtures/**/dist/
!crates/nimbus-runtime/src/runtime/tests/node_compat_fixtures/**/dist/**
.DS_Store
**/.DS_Store
.pytest_cache
**/.pytest_cache
__pycache__
**/__pycache__
*.py[cod]
.env
# Official Node fixtures include .env test data (dotenv/run-script/test-runner);
# keep them versioned so CI runs the same corpus as local.
!crates/nimbus-runtime/src/runtime/tests/node_compat_fixtures/**/.env
.claude/settings.local.json
.claude/scheduled_tasks.lock
.nimbus
**/.nimbus

# Staged JS package payloads embedded by nimbus-assets (build output; BPD)
crates/nimbus-assets/embedded/packages/

# playwright-cli snapshots/screenshots/traces (per-session artifacts)
**/.playwright-cli/*
# UL3 screencast is a committed deliverable referenced from the update-lifecycle plan.
!/.playwright-cli/ul3/
/.playwright-cli/ul3/*
!/.playwright-cli/ul3/full-flow.webm
# Playwright runner artifacts (when run from repo root)
test-results/
playwright-report/
.env.local
**/.env.local
demos/convex/vendor/browser.bundle.js
# Local runtime and machine state
data/

# The entire docs/private tree is private working state and business
# context (plans, proofs, decisions, strategy). It stays on local disks
# for agents but is never tracked — user directive 2026-06-11.
# Pipeline-owned runtime-compat inputs that builds and CI depend on live
# under tests/runtime/node/ instead, never here.
docs/private/
