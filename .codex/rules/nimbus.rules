# Nimbus project-local Codex command policy.
# Keep this file focused on execution policy; keep architecture/process
# guidance in AGENTS.md.
#
# Policy model:
# - `allow`: routine repo work that should run directly.
# - `prompt`: risky-but-legitimate actions that should route to Auto-review
#   when "Approve for me" / `approvals_reviewer = "auto_review"` is active.
# - `forbidden`: destructive actions Codex should not run.
#
# Codex `.rules` are static and are loaded into a session snapshot. They cannot
# currently express "prompt in Approve for me, but allow in Full access." Keep
# prompt rules reserved for actions we want the reviewer agent to inspect. Do
# not run this repo with approval_policy="never" unless prompt-rule denials are
# acceptable.

# Safe verification loops for this repo.
prefix_rule(
    pattern = ["cargo", "test"],
    decision = "allow",
    justification = "Focused Rust test runs are a normal verification path here.",
    match = [
        "cargo test -p nimbus-runtime node22_networking_dgram_remaining_batch_fixture -- --nocapture --test-threads=1",
        "cargo test -p nimbus-engine",
    ],
)

prefix_rule(
    pattern = ["cargo", "check"],
    decision = "allow",
    justification = "Rust compile checks are routine and safe.",
    match = [
        "cargo check --workspace",
        "cargo check -p nimbus-runtime",
    ],
)

prefix_rule(
    pattern = ["cargo", "clippy"],
    decision = "allow",
    justification = "Rust lint runs are routine and safe.",
    match = [
        "cargo clippy -p nimbus-runtime --all-targets -- -D warnings",
    ],
)

prefix_rule(
    pattern = ["cargo", "fmt"],
    decision = "allow",
    justification = "Formatting checks are routine and safe.",
    match = [
        "cargo fmt --all --check",
    ],
)

prefix_rule(
    pattern = ["make", "check"],
    decision = "allow",
    justification = "Repo verification entrypoint.",
    match = [
        "make check",
    ],
)

prefix_rule(
    pattern = ["make", "clippy"],
    decision = "allow",
    justification = "Repo lint entrypoint.",
    match = [
        "make clippy",
    ],
)

prefix_rule(
    pattern = ["make", "test"],
    decision = "allow",
    justification = "Repo test entrypoint.",
    match = [
        "make test",
    ],
)

prefix_rule(
    pattern = ["npm", "run", "test"],
    decision = "allow",
    justification = "JS test runs are routine and safe.",
    match = [
        "npm run test",
    ],
)

prefix_rule(
    pattern = ["npm", "run", "build"],
    decision = "allow",
    justification = "JS build verification is routine and safe.",
    match = [
        "npm run build",
    ],
)

prefix_rule(
    pattern = ["npm", "run", "typecheck"],
    decision = "allow",
    justification = "JS typecheck verification is routine and safe.",
    match = [
        "npm run typecheck",
    ],
)

# Read-only git inspection.
prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Read-only worktree inspection.",
    match = [
        "git status --short",
        "git status",
    ],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Read-only diff inspection.",
    match = [
        "git diff --check",
        "git diff -- AGENTS.md",
    ],
)

prefix_rule(
    pattern = ["git", "show"],
    decision = "allow",
    justification = "Read-only git object inspection.",
    match = [
        "git show HEAD:Cargo.toml",
    ],
)

prefix_rule(
    pattern = ["git", "rev-parse"],
    decision = "allow",
    justification = "Read-only git revision inspection.",
    match = [
        "git rev-parse HEAD",
    ],
)

prefix_rule(
    pattern = ["git", "describe"],
    decision = "allow",
    justification = "Read-only tag inspection.",
    match = [
        "git describe --tags --exact-match HEAD",
    ],
)

# Local staging operations.
prefix_rule(
    pattern = ["git", "add", [".", "-A", "--all", "-u", "--update"]],
    decision = "prompt",
    justification = "Bulk staging can accidentally include unrelated user changes and requires explicit approval.",
    match = [
        "git add .",
        "git add -A",
        "git add --all",
        "git add -u",
        "git add --update",
    ],
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Path-specific staging is a normal local workflow when the agent has inspected the intended file changes.",
    match = [
        "git add .github/workflows/ci.yml",
        "git add .codex/rules/nimbus.rules",
    ],
)

prefix_rule(
    pattern = ["git", "commit", ["--amend", "--no-verify", "--allow-empty", "--allow-empty-message"]],
    decision = "prompt",
    justification = "Amending history, bypassing hooks, or creating empty commits requires explicit approval.",
    match = [
        "git commit --amend",
        "git commit --no-verify -m example",
        "git commit --allow-empty -m example",
        "git commit --allow-empty-message -m \"\"",
    ],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Ordinary local commits are allowed after the agent has staged, verified, and described the intended changes.",
    match = [
        "git commit -m \"Skip Windows ptrcomp simdutf artifacts\"",
        "git commit -m \"Update CI\"",
    ],
)

# Git network sync operations.
prefix_rule(
    pattern = ["git", "fetch"],
    decision = "allow",
    justification = "Fetching remote refs and tags is a normal read/sync workflow and does not publish local changes.",
    match = [
        "git fetch origin nimbus/v149.4.0 --tags",
        "git fetch origin",
        "git fetch --tags",
    ],
)

prefix_rule(
    pattern = ["git", "pull"],
    decision = "allow",
    justification = "Pulling upstream changes is a normal repository sync workflow.",
    match = [
        "git pull",
        "git pull --ff-only",
        "git pull --rebase",
    ],
)

prefix_rule(
    pattern = ["git", "clone"],
    decision = "allow",
    justification = "Cloning repositories is a normal setup and research workflow; filesystem policy still constrains clone destinations.",
    match = [
        "git clone git@github.com:nimbus/nimbus.git",
        "git clone https://github.com/openai/codex.git",
    ],
)

# Branch/worktree navigation.
prefix_rule(
    pattern = ["git", "switch", ["-C", "--force-create", "-f", "--force", "--discard-changes"]],
    decision = "prompt",
    justification = "Force-resetting a branch or discarding worktree changes requires explicit approval.",
    match = [
        "git switch -C codex/example origin/main",
        "git switch --force-create codex/example origin/main",
        "git switch -f main",
        "git switch --discard-changes main",
    ],
)

prefix_rule(
    pattern = ["git", "switch"],
    decision = "allow",
    justification = "Branch switching and new branch creation are normal local navigation workflows; Git preserves local changes unless forced.",
    match = [
        "git switch main",
        "git switch -c codex/skip-windows-ptrcomp-simdutf origin/nimbus/v149.4.0",
    ],
)

# Allow ordinary branch publication in no-approval Desktop/goal sessions, but
# keep history-rewriting and raw transport paths behind an approval boundary.
prefix_rule(
    pattern = ["git", "push", ["--force", "--force-with-lease", "--force-if-includes", "--mirror", "--all"]],
    decision = "prompt",
    justification = "History-rewriting or broad push commands require explicit approval.",
    match = [
        "git push --force origin main",
        "git push --force-with-lease origin main",
        "git push --mirror origin",
        "git push --all origin",
    ],
    not_match = [
        "git push origin main --force",
    ],
)

prefix_rule(
    pattern = ["git", "push", ["--delete", "-d"]],
    decision = "prompt",
    justification = "Deleting remote refs requires explicit approval.",
    match = [
        "git push --delete origin old-branch",
        "git push -d origin old-branch",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", ["--delete", "-d"]],
    decision = "prompt",
    justification = "Deleting remote refs requires explicit approval.",
    match = [
        "git push origin --delete old-branch",
        "git push origin -d old-branch",
    ],
    not_match = [
        "git push origin :old-branch",
    ],
)

prefix_rule(
    pattern = ["git", "push", ["--tags", "--follow-tags"]],
    decision = "prompt",
    justification = "Publishing tags requires explicit approval.",
    match = [
        "git push --tags",
        "git push --follow-tags",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", ["--tags", "--follow-tags"]],
    decision = "prompt",
    justification = "Publishing tags requires explicit approval.",
    match = [
        "git push origin --tags",
        "git push origin --follow-tags",
    ],
)

prefix_rule(
    pattern = ["git", "send-pack"],
    decision = "prompt",
    justification = "Raw Git transport bypasses normal git push policy and requires explicit approval.",
    match = [
        "git send-pack git@github.com:nimbus/nimbus.git HEAD:refs/heads/codex/example",
    ],
)

# Execpolicy matches argument prefixes, not full Git semantics. The prompt
# rules above catch common dangerous leading forms; they do not catch every
# suffix flag or refspec spelling.
prefix_rule(
    pattern = ["git", "push"],
    decision = "allow",
    justification = "Ordinary branch publication is allowed after the agent has staged, verified, and described the intended push.",
    match = [
        "git push origin main",
        "git push origin HEAD:refs/heads/codex/example",
    ],
)

prefix_rule(
    pattern = ["git", "tag", ["-d", "--delete"]],
    decision = "prompt",
    justification = "Deleting local tags requires explicit approval.",
    match = [
        "git tag -d v2.7.14-locker.33",
        "git tag --delete v2.7.14-locker.33",
    ],
)

prefix_rule(
    pattern = ["git", "tag", ["-f", "--force"]],
    decision = "prompt",
    justification = "Replacing an existing tag requires explicit approval.",
    match = [
        "git tag -f v2.7.14-locker.33",
        "git tag --force v2.7.14-locker.33",
    ],
)

prefix_rule(
    pattern = ["git", "tag"],
    decision = "allow",
    justification = "Ordinary tag creation and inspection are allowed; tag publication is guarded by git push tag rules.",
    match = [
        "git tag v2.7.14-locker.33",
        "git tag -a v2.7.14-locker.33 -m v2.7.14-locker.33",
        "git tag --list",
    ],
)

prefix_rule(
    pattern = ["cargo", "update"],
    decision = "prompt",
    justification = "Dependency graph changes should stay intentional.",
    match = [
        "cargo update -p deno_node",
    ],
)

prefix_rule(
    pattern = ["cargo", "add"],
    decision = "prompt",
    justification = "Adding Rust dependencies should stay intentional.",
    match = [
        "cargo add anyhow",
    ],
)

prefix_rule(
    pattern = ["npm", "install"],
    decision = "prompt",
    justification = "Installing JS dependencies should stay intentional.",
    match = [
        "npm install",
        "npm install typescript",
    ],
)

# Block common destructive commands by default.
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard worktree state; inspect and edit intentionally instead.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD",
    ],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Avoid destructive recursive deletion from Codex.",
    match = [
        "rm -rf target",
        "rm -rf /tmp/example",
    ],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Use normal sandbox approval flows instead of sudo.",
    match = [
        "sudo make install",
    ],
)
