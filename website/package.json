{
  "name": "nimbus-docs-website",
  "private": true,
  "type": "module",
  "description": "Renderer for nimbusdocs.com: Next static export with fumadocs over docs/ content. Standalone npm project, deliberately not a workspace member.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "preview:deploy": "wrangler versions upload"
  },
  "dependencies": {
    "@fumadocs/tailwind": "0.1.1",
    "fumadocs-core": "16.15.9",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.9",
    "lucide-react": "^1.24.0",
    "next": "16.3.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.99.0"
  }
}
