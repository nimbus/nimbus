{
  "name": "nimbus-agent-chat",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "codegen": "nimbus-codegen --app .",
    "dev": "npm run codegen && vite",
    "build": "npm run codegen && vite build",
    "smoke": "npm run codegen && node --experimental-strip-types ./smoke.ts",
    "typecheck": "npm run codegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.smoke.json --noEmit",
    "test": "npm run codegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.smoke.json --noEmit"
  },
  "dependencies": {
    "@nimbus/nimbus": "file:./.nimbus/packages/@nimbus/nimbus",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@nimbus/codegen": "*",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "6.0.3",
    "vite": "8.0.9"
  }
}
