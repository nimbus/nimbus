[Unit]
Description=Nimbus server
Documentation=https://nimbusdocs.com/operators/deploy-linux/
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=nimbus
Group=nimbus
# Pin the home the service sees so the local admin token always lands
# under the state directory, regardless of how systemd populates the
# environment.
Environment=HOME=/var/lib/nimbus
# Optional operator overrides (NIMBUS_* environment variables, e.g.
# NIMBUS_DATA_DIR or NIMBUS_CORS_ALLOW_ORIGINS).
EnvironmentFile=-/etc/nimbus/nimbus.env
StateDirectory=nimbus
WorkingDirectory=/var/lib/nimbus
ExecStart=/usr/bin/nimbus start --host 127.0.0.1 --port 8080 --data-dir /var/lib/nimbus/data
Restart=on-failure
RestartSec=2

# Hardening. The unit covers the plain server; features that drive the
# container stack (Compose services, machines) may need a drop-in that
# relaxes specific settings.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nimbus
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
