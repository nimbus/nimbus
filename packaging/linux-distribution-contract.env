NIMBUS_CRUN_UPSTREAM_VERSION=1.27.1
NIMBUS_LIBKRUN_VERSION=v1.17.4-nimbus.1
NIMBUS_LIBKRUN_UPSTREAM_VERSION=1.17.4
APT_REPOSITORY_DISTRIBUTION=stable
COPR_PROJECT=nimbus/nimbus
